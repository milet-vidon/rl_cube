    def Xform "Table"
    {
        quatd xformOp:orient = (1, 0, 0, 0)
        double3 xformOp:scale = (1, 1, 1)
        double3 xformOp:translate = (0.6000000238418579, 0, 0.8799999952316284)
        uniform token[] xformOpOrder = ["xformOp:translate", "xformOp:orient", "xformOp:scale"]

        def "geometry"
        {
            def Cube "mesh" (
                prepend apiSchemas = ["PhysicsCollisionAPI", "PhysxCollisionAPI", "MaterialBindingAPI"]
            )
            {
                rel material:binding = </World/Table/geometry/material> (
                    bindMaterialAs = "strongerThanDescendants"
                )
                rel material:binding:physics = </World/Table/geometry/material> (
                    bindMaterialAs = "strongerThanDescendants"
                )
                float physxCollision:contactOffset = 0.001
                double size = 0.04
                quatd xformOp:orient = (1, 0, 0, 0)
                double3 xformOp:scale = (20, 22.5, 1)
                double3 xformOp:translate = (0, 0, 0)
                uniform token[] xformOpOrder = ["xformOp:translate", "xformOp:orient", "xformOp:scale"]
            }

            def Material "material" (
                prepend apiSchemas = ["PhysicsMaterialAPI"]
            )
            {
                token outputs:displacement.connect = </World/Table/geometry/material/Shader.outputs:displacement>
                token outputs:surface.connect = </World/Table/geometry/material/Shader.outputs:surface>
                float physics:dynamicFriction = 0.7
                float physics:restitution = 0
                float physics:staticFriction = 0.8

                def Shader "Shader"
                {
                    uniform token info:id = "UsdPreviewSurface"
                    custom color3f inputs:diffuseColor = (0.32, 0.35, 0.4)
                    custom color3f inputs:emissiveColor = (0, 0, 0)
                    float inputs:metallic = 0
                    float inputs:opacity = 1
                    float inputs:roughness = 0.5
                    token outputs:displacement
                    token outputs:surface
                }
            }
        }
    }

