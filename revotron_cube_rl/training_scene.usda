                rel material:binding:physics = </World/Table/geometry/material> (
                    bindMaterialAs = "strongerThanDescendants"
                )
                float physxCollision:contactOffset = 0.001
                double size = 0.04
                quatd xformOp:orient = (1, 0, 0, 0)
                double3 xformOp:scale = (20, 22.5, 1)
                double3 xformOp:translate = (0, 0, 0)
                uniform token[] xformOpOrder = ["xformOp:translate", "xformOp:orient", "xformOp:scale"]
            }

            def Material "material" (
                prepend apiSchemas = ["PhysicsMaterialAPI"]
            )
            {
                token outputs:displacement.connect = </World/Table/geometry/material/Shader.outputs:displacement>
                token outputs:surface.connect = </World/Table/geometry/material/Shader.outputs:surface>
                float physics:dynamicFriction = 0.7
                float physics:restitution = 0
                float physics:staticFriction = 0.8

                def Shader "Shader"
                {
                    uniform token info:id = "UsdPreviewSurface"
                    custom color3f inputs:diffuseColor = (0.32, 0.35, 0.4)
                    custom color3f inputs:emissiveColor = (0, 0, 0)
                    float inputs:metallic = 0
                    float inputs:opacity = 1
                    float inputs:roughness = 0.5
                    token outputs:displacement
                    token outputs:surface
                }
            }
        }
    }

    def Xform "Ground"
    {
        quatd xformOp:orient = (1, 0, 0, 0)
        double3 xformOp:scale = (1, 1, 1)
        double3 xformOp:translate = (0, 0, -0.010999999940395355)
        uniform token[] xformOpOrder = ["xformOp:translate", "xformOp:orient", "xformOp:scale"]

        def "geometry"
        {
            def Cube "mesh" (
                prepend apiSchemas = ["PhysicsCollisionAPI", "MaterialBindingAPI"]
            )
            {
                rel material:binding = </World/Ground/geometry/material> (
                    bindMaterialAs = "strongerThanDescendants"
                )
                double size = 0.02
                quatd xformOp:orient = (1, 0, 0, 0)
                double3 xformOp:scale = (250, 250, 1)
                double3 xformOp:translate = (0, 0, 0)
                uniform token[] xformOpOrder = ["xformOp:translate", "xformOp:orient", "xformOp:scale"]
            }

            def Material "material"
            {
                token outputs:displacement.connect = </World/Ground/geometry/material/Shader.outputs:displacement>
                token outputs:surface.connect = </World/Ground/geometry/material/Shader.outputs:surface>

                def Shader "Shader"
                {
                    uniform token info:id = "UsdPreviewSurface"
                    custom color3f inputs:diffuseColor = (0.17, 0.19, 0.22)
                    custom color3f inputs:emissiveColor = (0, 0, 0)
                    float inputs:metallic = 0
                    float inputs:opacity = 1
                    float inputs:roughness = 0.5
                    token outputs:displacement
                    token outputs:surface
                }
            }
        }
    }

    def Xform "Cube" (
        prepend apiSchemas = ["PhysxContactReportAPI"]
        prepend references = @locked_cube.usda@
    )
    {
        vector3f physics:angularVelocity = (0.22951557, 0.71919215, -0.039202686)
        vector3f physics:velocity = (0.00044592467, -0.00016858437, -0.00033617095)
        float physxContactReport:threshold = 0
        bool physxRigidBody:disableGravity = 0
        float physxRigidBody:maxDepenetrationVelocity = 1
        float physxRigidBody:sleepThreshold = 0
        int physxRigidBody:solverPositionIterationCount = 32
        int physxRigidBody:solverVelocityIterationCount = 4
        quatd xformOp:orient = (0.9991450905799866, -3.435742144120013e-7, -0.0000013916716170569998, 0.04134107008576393)
        double3 xformOp:scale = (1, 1, 1)
        double3 xformOp:translate = (0.4837527573108673, 0.011916432529687881, 0.9285000562667847)
        uniform token[] xformOpOrder = ["xformOp:translate", "xformOp:orient", "xformOp:scale"]
    }

    def DomeLight "Light"
    {
        color3f inputs:color = (1, 1, 1)
        float inputs:colorTemperature = 6500
        bool inputs:enableColorTemperature = 0
        float inputs:exposure = 0
        float inputs:intensity = 1800
        bool inputs:normalize = 0
        asset inputs:texture:file
        token inputs:texture:format = "automatic"
        bool visibleInPrimaryRay = 1
        quatd xformOp:orient = (1, 0, 0, 0)
        double3 xformOp:scale = (1, 1, 1)
        double3 xformOp:translate = (0, 0, 0)
        uniform token[] xformOpOrder = ["xformOp:translate", "xformOp:orient", "xformOp:scale"]
    }

    def Camera "Overview" (
        prepend apiSchemas = ["OmniRtxCameraAutoExposureAPI_1", "OmniRtxCameraExposureAPI_1"]
    )
    {
        custom token cameraProjectionType = "pinhole"
        float2 clippingRange = (0.01, 1000000)
        float exposure:fStop = 5
        float exposure:responsivity = 1.1026709
        float exposure:time = 0.02
        float focalLength = 30
        float focusDistance = 400
        float fStop = 0
        float horizontalAperture = 24
        float horizontalApertureOffset = 0
        bool omni:kit:cameraLock = 1
        float verticalAperture = 19.2
        float verticalApertureOffset = 0
        quatd xformOp:orient = (0.7453154921531677, 0.5459470792784388, 0.22613866808985758, 0.30871978650285564)
        double3 xformOp:scale = (1, 1, 0.9999999999999999)
        double3 xformOp:translate = (2.0999999046325684, -1.899999976158142, 1.899999976158142)
        uniform token[] xformOpOrder = ["xformOp:translate", "xformOp:orient", "xformOp:scale"]
    }
}

